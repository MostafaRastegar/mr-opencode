# Copy the keys this project needs into `.env` (never commit that file).
# Use placeholder names here, never real values.
#
# Web search, when opencode.jsonc sets `websearch.provider`:
# <PROVIDER>_API_KEY=
#
# 9Router custom provider (`providers.9router` in opencode.jsonc):
# ROUTER_API_KEY=
#
# Application secrets this project requires:
# <SECRET_NAME>=
