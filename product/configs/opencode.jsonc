{
  "$schema": "https://opencode.ai/config.json",

  // Custom OpenAI-compatible provider for the local 9Router gateway. Why: the
  // gateway exposes one endpoint for every model id it proxies.
  // Change: point `settings.baseURL` at your gateway, or delete this block when
  // you use a catalog provider. The key comes from `ROUTER_API_KEY`.
  "providers": {
    "9router": {
      "name": "9Router",
      "env": ["ROUTER_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:20128/v1"
      },
      "models": {
        "deep": {
          "name": "deep"
        },
        "nemo": {
          "name": "nemo"
        }
      }
    }
  },

  // Default model for sessions that do not select one (for example the built-in
  // `build` agent). Every file in .opencode/agents/ pins its own model.
  // Why: an unpinned session used whatever the client last selected, which can
  // be a paid model. Change: use any id from `opencode models`.
  "model": "9router/nemo",

  // New sessions start in the Orchestrator, which plans, delegates, and gates
  // approval before any code is written. Why: matches the Orchestrated Workflow
  // in AGENTS.md. Change: "mro-architect" for the manual flow, "build" for a
  // plain session, "mro-implementer" to go straight to code.
  "default_agent": "mro-orchestrator",

  // Format every file the write/edit/patch tools touch.
  // Why: keeps agent output aligned with the project style. Change: false to
  // turn off, or configure per-language formatters instead of `true`.
  "formatter": true,

  // Filesystem snapshots power /undo and /redo. Why: an agent mistake can be
  // reverted without a commit. Change: false only if you always commit first.
  "snapshots": true,

  // Who may share sessions. Why: sessions contain source code and can contain
  // secrets. "manual" still allows /share; "auto" shares every new session.
  // Change: "manual" if you want the option back.
  "share": "disabled",

  // Directories the filesystem watcher ignores. Empty on purpose: the template
  // does not assume a build system. Add this project's heavy directories, for
  // example "node_modules/**", ".venv/**", "dist/**", or "target/**".
  // Why: build output churn burns CPU and pollutes file search.
  "watcher": {
    "ignore": []
  },

  // How much tool output is kept before truncation. Why: a failing test suite is
  // often longer than the 2000-line / 51200-byte default, and truncated output
  // is written to disk but costs the agent a second read.
  // Change: lower both to save context, raise max_bytes for very noisy suites.
  "tool_output": {
    "max_lines": 4000,
    "max_bytes": 102400
  },

  // LSP is accepted by the v2.3.0 schema but not implemented in that build:
  // verified on a real TypeScript project, no language-server process starts,
  // edit results carry no diagnostics, and there is no diagnostics tool.
  // Why off: an enabled-but-dead key looks healthy while doing nothing.
  // Change: uncomment when a build actually starts servers, and re-add the
  // "fix LSP diagnostics first" rule to AGENTS.md.
  // "lsp": true,

  // Ordered tool permissions. The LAST matching rule wins, and agent rules are
  // appended after these, so a broad rule here can be overridden per agent.
  // Base policy already allows everything; each restriction must therefore
  // come after the broad rule it narrows.
  "permissions": [
    // Ask before any shell command. Why: shell runs with the user's filesystem,
    // process, and network authority.
    // Change: "deny" for a read-only session, or remove for full autonomy.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Read-only git inspection is safe and frequent.
    // Change: add other read-only commands you use constantly.
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "git branch --show-current *",
      "effect": "allow"
    },

    // Publishing and privilege escalation are outside this workflow.
    // Why: no agent should deploy or gain root, even after a mistaken approval.
    // Change: remove only if a human-reviewed release process exists.
    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "sudo *", "effect": "deny" },

    // Secret-bearing files are not readable by the `read` tool. Note: this does
    // not stop `shell` from printing them; keep shell on "ask".
    // Change: adapt the patterns to this project's secret locations.
    { "action": "read", "resource": "*.env*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.npmrc", "effect": "deny" },
    { "action": "read", "resource": "*.netrc", "effect": "deny" },
    { "action": "read", "resource": "*.git-credentials", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "id_rsa*", "effect": "deny" },

    // Anything outside the project needs a human decision, as AGENTS.md says.
    // Why: the default policy permits external paths without a prompt.
    // Change: "deny" to block outright, or remove if you work across siblings.
    { "action": "external_directory", "resource": "*", "effect": "ask" },

    // Writes the agent must never perform. Why: .env files hold secrets, .git
    // holds history, .githooks holds the secret scan, and the rest are the
    // agent's own guardrails. A human edits these by hand.
    // Change: drop a line when you want the agent to maintain that file.
    { "action": "edit", "resource": "*.env*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": ".git/*", "effect": "deny" },
    { "action": "edit", "resource": ".githooks/*", "effect": "deny" },
    { "action": "edit", "resource": "AGENTS.md", "effect": "deny" },
    { "action": "edit", "resource": "opencode.jsonc", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/agents/*", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/plugins/*", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/skills/*", "effect": "deny" },
    { "action": "edit", "resource": ".opencode/commands/*", "effect": "deny" }
  ],

  // Policies are evaluated after permissions and saved approvals, and can only
  // deny. Why: they survive "Allow always" and any agent-level allow rule.
  // Change: add shell:<command> entries for commands that must never run.
  "policies": [
    { "action": "tool.use", "resource": "shell:sudo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" }
  ],

  // Background agents. Why: titles, summaries, and compaction do not need the
  // strong model; the `build` agent uses the same model as the roles.
  // `build` is pinned too so an ad-hoc session cannot silently use a paid model.
  // Change: `small_model` is deprecated in V2 — set these entries instead.
  "agents": {
    "title": { "model": "9router/nemo" },
    "summary": { "model": "9router/nemo" },
    "compaction": { "model": "9router/nemo" },
    "build": { "model": "9router/deep" }
  },

  // Compaction keeps the summary plus a verbatim tail of recent turns.
  // Why 24000: API contracts and diffs were being summarized away at the 15k
  // default; 20% buffer starts early enough to avoid a hard context stop.
  // Change: raise keep.tokens if recent detail still disappears, lower it if
  // context cost matters more.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 24000 },
    "buffer": "20%"
  },

  // Web search is unset on purpose: the template does not assume a provider.
  // Why: a provider id with no matching credential just fails at runtime.
  // Change: add `{ "websearch": { "provider": "<PROVIDER_ID>" } }` and set the
  // paired `<PROVIDER>_API_KEY`; with no provider, the first search asks.

  // Experimental settings; they may change or disappear between releases.
  // todo: gives agents a todowrite tool for multi-step work, which makes long
  // implementer runs visible step by step.
  // background_compaction: writes the summary before it is needed, so automatic
  // compaction does not pause the session.
  // Change: remove either key if a release breaks it; both default to false.
  "experimental": {
    "todo": true,
    "background_compaction": true
  }
}
