#!/usr/bin/env python3
"""Git pre-push hook: verify OpenCode config before allowing push.

Runs the unit tests and `opc-sync.py --repo . verify` against this checkout.
Exits non-zero to abort the push if either check fails. No npm / node_modules
required — stdlib Python only.
"""
import subprocess
import sys
from pathlib import Path


def run(cmd, cwd=None):
    """Run a command, streaming stdout/stderr to the terminal."""
    print(f"$ {' '.join(cmd)}")
    proc = subprocess.run(cmd, cwd=cwd)
    return proc.returncode


def main() -> int:
    # dev/scripts/git-hooks/pre-push -> repo root
    repo_root = Path(__file__).resolve().parents[3]
    ok = True

    print("=== pre-push hook: running unit tests ===")
    if run([sys.executable, "dev/tests/test_opc_sync.py"], cwd=repo_root) != 0:
        ok = False

    print("=== pre-push hook: verifying config drift ===")
    if run([sys.executable, "dev/scripts/opc-sync.py", "--repo", ".", "verify"],
           cwd=repo_root) != 0:
        ok = False

    if ok:
        print("pre-push: all checks passed.")
        return 0

    print("pre-push: checks FAILED — push aborted.")
    return 1


if __name__ == "__main__":
    sys.exit(main())